libposix_gnu_locale = static_library(
	'posix_gnu_locale',
	'C-collate.c',
	'C-ctype.c',
	'C-messages.c',
	'C-monetary.c',
	'C-numeric.c',
	'C-time.c',
	'C_name.c',
	'coll-lookup.c',
	'global-locale.c',
	'lc-collate.c',
	'lc-ctype.c',
	'lc-messages.c',
	'lc-monetary.c',
	'lc-numeric.c',
	'xlocale.c',
	cpp_args: [
		'LOCALEDIR=\'"/share/locale"\'',
		'USE_IN_LIBIO',
		'_GNU_SOURCE',
	],
	include_directories: [
	],
)
